{
  "name": "mistvale-chronicles-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.api.json && tsc -b && vite build --base ./",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test": "vitest --environment jsdom",
    "test:run": "vitest run --environment jsdom",
    "validate:scenes": "node scripts/validate-scene-variants.mjs",
    "preview": "vite preview",
    "generate:character-sheets": "node --experimental-strip-types scripts/generate-character-sheets.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "dexie": "^4.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.9.8",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "playwright-core": "1.58.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
