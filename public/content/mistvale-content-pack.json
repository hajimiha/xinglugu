  "lorebooks": [
    {
      "id": "mistvale-production-partners",
      "name": "雾灯谷·农场生产与共生伙伴",
      "description": "农场开拓、机器加工、金属锻造、节庆作物与六位魔物娘伙伴的稳定规则。",
      "recursiveScanning": true,
      "caseSensitive": false,
      "matchWholeWords": false,
      "createdAt": 1786204800000,
      "updatedAt": 1786204800000,
      "entries": [
        {
          "id": "mistvale-production-chain",
          "keys": [
            "开拓田地",
            "熔炉",
            "磨粉机",
            "锭",
            "锻造",
            "莓果挞"
          ],
          "secondaryKeys": [],
          "content": "玩家可消耗1点精力开拓一行田地并获得木头、石头，概率发现月铃花；锄头等级越高，新行格数和月铃花概率越高。石头可建造熔炉，木头、石头与金币可建造转动磨粉机。熔炉按3份矿石烧制1份对应金属锭；磨粉机按2份夕照麦研磨1份面粉。余烬莓2份、蜂蜜1份、面粉1份和牛奶1份可制作莓果挞。",
          "comment": "农场生产链",
          "order": 10,
          "position": "before_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": true,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-production-power",
          "keys": [
            "火系魔法",
            "水系魔法",
            "点火",
            "研磨",
            "加工完成"
          ],
          "secondaryKeys": [],
          "content": "玩家学会火系魔法后可花费1点精力为熔炉点火，学会水系魔法后可花费1点精力驱动磨粉机。火史莱姆娘和水史莱姆娘入驻后可分别免除对应机器的精力消耗。机器启动后按批次数量等待完成，旅行与消磨时间都会推进加工进度。",
          "comment": "机器动力与等待",
          "order": 15,
          "position": "before_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": true,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-production-mining",
          "keys": [
            "铜矿",
            "铁矿",
            "钻石矿",
            "锄头",
            "镐",
            "长剑",
            "护甲"
          ],
          "secondaryKeys": [],
          "content": "矿洞会产出铜矿石、铁矿石和石头，第10层起才出现钻石矿。更高等级的镐提高矿石收获。铜锭、铁锭、钻石锭可依次在铁匠铺付费打造更高级的锄头、镐、长剑与护甲；锄头强化农场开拓，镐强化采矿，长剑提升物理攻击，护甲提升生命上限。",
          "comment": "矿物与装备",
          "order": 20,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-production-festival-seeds",
          "keys": [
            "余烬莓",
            "潮汐莲",
            "岩纹南瓜",
            "限定种子"
          ],
          "secondaryKeys": [],
          "content": "潮汐莲种子只在6月21日长昼渔火祭的渔家售卖；岩纹南瓜种子只在8月15日月穗丰收会的杂货店售卖；余烬莓种子只在9月9日羽火锻造祭的铁匠铺售卖。模型不得在其他日期或地点声称可以买到这些种子。",
          "comment": "节庆限定作物",
          "order": 25,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-partner-cow",
          "keys": [
            "牛奶娘",
            "牛奶",
            "乳品伙伴"
          ],
          "secondaryKeys": [],
          "content": "牛奶娘是女性共生伙伴，只能在玩家先购得共生牧场后签约入住。她每日生产1份牛奶；牛奶可制作莓果挞、出售或作为偏爱礼物。她重视规律生活、牧场清洁与彼此照料。",
          "comment": "牛奶娘",
          "order": 100,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-partner-bee",
          "keys": [
            "蜂娘",
            "蜂蜜",
            "花蜜伙伴"
          ],
          "secondaryKeys": [],
          "content": "蜂娘是女性共生伙伴，只能在玩家先购得共生牧场后签约入住。她每日生产1份蜂蜜；蜂蜜可制作莓果挞、出售或作为偏爱礼物。她熟悉花期与天气，工作时讲究秩序。",
          "comment": "蜂娘",
          "order": 105,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-partner-spider",
          "keys": [
            "蜘蛛娘",
            "线团",
            "纺丝伙伴"
          ],
          "secondaryKeys": [],
          "content": "蜘蛛娘是女性共生伙伴，只能在玩家先购得共生牧场后签约入住。她每日生产1份线团；线团可赠送给绮萝或出售。她擅长纺织、修补旧物与整理纤维材料。",
          "comment": "蜘蛛娘",
          "order": 110,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-partner-fire-slime",
          "keys": [
            "火史莱姆娘",
            "史莱姆粘液",
            "熔炉伙伴"
          ],
          "secondaryKeys": [],
          "content": "火史莱姆娘是女性共生伙伴，每日生产1份史莱姆粘液，并可免除玩家为熔炉点火的精力消耗。她能稳定炉温，但不会跳过正常的烧制等待时间。",
          "comment": "火史莱姆娘",
          "order": 115,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-partner-water-slime",
          "keys": [
            "水史莱姆娘",
            "史莱姆粘液",
            "磨坊伙伴"
          ],
          "secondaryKeys": [],
          "content": "水史莱姆娘是女性共生伙伴，每日生产1份史莱姆粘液，并可免除玩家驱动磨粉机的精力消耗。她能稳定水轮，但不会跳过正常的研磨等待时间。",
          "comment": "水史莱姆娘",
          "order": 120,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-partner-dragon",
          "keys": [
            "龙娘",
            "龙巢",
            "第20层",
            "20000金币"
          ],
          "secondaryKeys": [],
          "content": "龙娘是女性共生伙伴，不在魔物娘商店售卖。她守在矿洞最深的第20层；玩家可击败她取得认可，或支付20000金币吸引她建立入住约定。只有拥有共生牧场后她才会正式入住。龙娘入住会提高第10层起的钻石矿收益。",
          "comment": "龙娘",
          "order": 125,
          "position": "after_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": false,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        },
        {
          "id": "mistvale-partner-consent",
          "keys": [
            "共生牧场",
            "契约",
            "魔物娘",
            "伙伴"
          ],
          "secondaryKeys": [],
          "content": "牛奶娘、蜂娘、蜘蛛娘、火史莱姆娘、水史莱姆娘与龙娘都是具有自主意愿的女性伙伴，不是无人格商品。前五位需要先建成共生牧场才能签约；龙娘遵循矿洞决战或金币约定规则。叙事应结合关系阶段表现信任变化，不得擅自修改游戏持有物、精力或入住状态。",
          "comment": "共生契约",
          "order": 5,
          "position": "before_char",
          "selective": false,
          "selectiveLogic": "and_any",
          "constant": true,
          "probability": 100,
          "useProbability": false,
          "addMemo": true
        }
      ]
    }
  ],
