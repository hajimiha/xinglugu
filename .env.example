# GitHub OAuth App（回调地址：https://你的域名/api/auth/github/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 至少 32 个随机字符，用于加密 HttpOnly 会话 Cookie
XINGLUGU_SESSION_SECRET=

# 部署后的完整 HTTPS 站点地址，不带末尾斜杠
XINGLUGU_APP_ORIGIN=https://your-domain.example

# 公开的“性撸谷创意工坊目录”Gist ID。该 Gist 需要开启评论，正文可只写用途说明。
XINGLUGU_WORKSHOP_CATALOG_GIST_ID=27a706cfd0a648fee5f43788b47ec615
